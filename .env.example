# MOIL ReserveIQ Environment Configuration Example

# Server & Runtimes
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB)
# Local instance: mongodb://127.0.0.1:27017/moil_reserveiq
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/moil_reserveiq?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/moil_reserveiq

# Authentication & Security
JWT_SECRET=moil_reserveiq_secret_super_secure_key_2026
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (Seeded / Managed)
ADMIN_EMAIL=vaishayvinayak@gmail.com
ADMIN_PASSWORD=vinayak@2006

# Email Delivery Configuration (SMTP)
# Leave blank to use development console logging mode
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_smtp_app_password
EMAIL_FROM=MOIL ReserveIQ <no-reply@moil.gov.in>

# Frontend URL (For email activation and password reset links)
FRONTEND_URL=http://localhost:5173

# Microservices
ML_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
